class Patron {
    private String name;
    private Book[] borrowedBooks;
    private static final int MAX_BOOKS = 10;

    public Patron(String name) {
        this.name = name;
        this.borrowedBooks = new Book[MAX_BOOKS];
    }

    public String getName() {
        return name;
    }

    public boolean borrowBook(Book book) {
        for (int i = 0; i < MAX_BOOKS; i++) {
            if (borrowedBooks[i] == null) {
                borrowedBooks[i] = book;
                return true;
            }
        }
        return false; // No space to borrow more books
    }

    public boolean returnBook(String isbn) {
        for (int i = 0; i < MAX_BOOKS; i++) {
            if (borrowedBooks[i] != null && borrowedBooks[i].getIsbn().equals(isbn)) {
                borrowedBooks[i] = null; // Return the book
                return true;
            }
        }
        return false; // Book not found
    }

    public boolean hasBorrowed(String isbn) {
        for (Book book : borrowedBooks) {
            if (book != null && book.getIsbn().equals(isbn)) {
                return true;
            }
        }
        return false; // Book not borrowed
    }

    @Override
    public String toString() {
        StringBuilder sb = new StringBuilder("Patron{" + "name='" + name + '\'' + ", borrowedBooks=[");
        for (Book book : borrowedBooks) {
            if (book != null) {
                sb.append(book.toString()).append(", ");
            }
        }
        sb.append("]}");
        return sb.toString();
    }
}







